# Salin berkas ini menjadi clients/secret.env lalu isi nilainya.
#
# Diambil dari Supabase Dashboard → Project Settings → API Keys → Secret key.
# Kunci ini melewati seluruh aturan RLS: siapa pun yang memilikinya bisa
# membaca dan mengubah data SEMUA klien. Ia hanya dipakai di mesin lokal
# untuk menjalankan skrip provisioning dan pemindahan gambar.
#
# Jangan pernah dipasang sebagai environment variable di Vercel — situs
# publik tidak pernah membutuhkannya.

SUPABASE_SECRET_KEY=sb_secret_ganti_dengan_kunci_asli
