# ---------------------------------------------------------------------
# Wajib diisi per project Vercel (1 project = 1 klien).
# ---------------------------------------------------------------------

# Sama untuk SEMUA klien (1 Supabase project dipakai bersama).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Kunci publik — aman ikut ke bundle browser.
# Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Project lama yang masih memakai `anon key` tetap didukung lewat
# NEXT_PUBLIC_SUPABASE_ANON_KEY, tapi kunci lama dihentikan akhir 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# BERBEDA per klien. Ambil dari kolom sites.id di Supabase.
NEXT_PUBLIC_SITE_ID=00000000-0000-4000-8000-000000000001

# URL produksi klien — dipakai untuk canonical, sitemap, dan OG image.
NEXT_PUBLIC_SITE_URL=https://domainklien.com

# ---------------------------------------------------------------------
# HANYA untuk skrip provisioning di /scripts, dijalankan di mesin lokal.
# JANGAN dipasang di project Vercel dan jangan di-commit.
# Dashboard → Project Settings → API Keys → Secret key (sb_secret_...).
# ---------------------------------------------------------------------
SUPABASE_SECRET_KEY=
